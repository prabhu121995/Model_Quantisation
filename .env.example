# Copy this file to .env and edit. Relative paths are resolved from the project root.

# Hugging Face model to quantise (repo id, NOT the Ollama tag "qwen3.5:4b")
MODEL_NAME=Qwen/Qwen3.5-4B

# Folder where quantised models are saved
MODELS_DIR=models

# Model loaded by `run` and `serve` (default: <MODELS_DIR>/<model>-int8)
MODEL_DIR=models/qwen3.5-4b-int8

# Backend for `run` / `serve`: gguf (llama.cpp, fast on CPU) or int8 (optimum-quanto, PyTorch)
BACKEND=gguf

# GGUF model (a .gguf file or a folder containing one) and quant type for `model-quantization gguf`
GGUF_PATH=models/qwen3.5-4b-gguf
GGUF_QUANT=Q4_K_M

# llama.cpp prebuilt binaries and source (converter script); CPU threads (0 = auto)
LLAMA_CPP_BIN=tools/llama.cpp/bin
LLAMA_CPP_SRC=tools/llama.cpp/src
LLAMA_THREADS=0

# FastAPI server (use HOST=0.0.0.0 to allow other devices on your network)
HOST=127.0.0.1
PORT=8000

# Default answer length
MAX_NEW_TOKENS=200

# Hugging Face account for `model-quantization upload`
HF_USERNAME=PrabhuAIML

# Optional: Hugging Face cache location / token (uncomment to use)
# HF_HOME=D:/hf-cache
# HF_TOKEN=
