# Copy this file to .env and edit. Relative paths are resolved from the project root.

# Hugging Face model to quantise (repo id, NOT the Ollama tag "qwen3.5:4b")
MODEL_NAME=Qwen/Qwen3.5-4B

# Folder where quantised models are saved
MODELS_DIR=models

# Model loaded by `run` and `serve` (default: <MODELS_DIR>/<model>-nf4-dq)
MODEL_DIR=models/qwen3.5-4b-nf4-dq

# KV cache: paged (block pool, like vLLM's PagedAttention), dynamic (transformers default),
# or none (no cache, recomputes everything each step - only for comparison)
KV_CACHE=paged
KV_BLOCK_SIZE=16
# Pool capacity in tokens (prompt + answer). 4096 tokens = 256 MB for Qwen3.5-4B in float32
KV_CACHE_TOKENS=4096

# CPU threads for PyTorch (0 = default)
TORCH_THREADS=0

# FastAPI server (use HOST=0.0.0.0 to allow other devices on your network)
HOST=127.0.0.1
PORT=8000

# Original Qwen3.5-4B running locally in Ollama (compared against the NF4-dq model by POST /ask)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=1800

# CSV log of every /ask call (start/end time, duration in sec and min, prompt, response)
LOG_CSV=logs/requests.csv

# Default answer length
MAX_NEW_TOKENS=200

# Hugging Face account for `model-quantization upload`
HF_USERNAME=PrabhuAIML

# Optional: Hugging Face cache location / token (uncomment to use)
# HF_HOME=D:/hf-cache
# HF_TOKEN=
